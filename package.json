{
    "name": "compoxic",
    "version": "0.1.0",
    "description": "Source-first Dual-Strokes SVG icon library for Next.js and Tailwind CSS.",
    "homepage": "https://compoxic.vercel.app",
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Nikhil Kumar Singh",
        "email": "connect.nikhilkumarsingh@gmail.com",
        "url": "https://github.com/cwnik"
    },
    "contributors": [
        {
            "name": "Nikhil Kumar Singh",
            "email": "connect.nikhilkumarsingh@gmail.com",
            "url": "https://github.com/cwnik"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cwnik/compoxic.git"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "vitest",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit --pretty",
        "lint": "eslint . --cache --cache-location .eslintcache",
        "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
        "format:check": "prettier -c \"**/*.{ts,tsx,md,mdx}\" --cache",
        "format:write": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
        "clean:all": "rm -rf .next node_modules .eslintcache package-lock.json tsconfig.tsbuildinfo",
        "clean:cache": "rm -rf .next .eslintcache tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "cn": "^0.4.0",
        "next": "16.3.5",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.13.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true
    },
    "engines": {
        "node": ">=24.x",
        "npm": ">=12"
    },
    "packageManager": "npm@12.0.2"
}
